ENVIRONMENT=development
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://127.0.0.1:11434/v1
RESIN_DB_HOST=127.0.0.1
RESIN_DB_PORT=3306
RESIN_DB_USER=readonly_user
RESIN_DB_PASSWORD=replace-me
RESIN_DB_NAME=ResinBasedThermalProtection
RESIN_TABLE_STATIC=material_static
RESIN_TABLE_MATERIAL_THERMAL_PROPERTY=material_thermal_property
RESIN_TABLE_THERMAL_RESPONSE=thermal_response
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=10
SESSION_STORE_MODE=auto
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_MODE=redis
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_BOOTSTRAP_DEMO_USERS=false
CORS_ORIGINS=http://localhost:5173
PROMETHEUS_MULTIPROC_DIR=/tmp/text2sql-prometheus
# Optional USD price per 1K tokens. Keep 0 for local Ollama models.
TEXT2SQL_COST_PROMPT_PER_1K_USD=0
TEXT2SQL_COST_COMPLETION_PER_1K_USD=0
